# Copy this file to ".env" and fill in your own values. Never commit the real ".env".

# API key requested at https://opendata.aemet.es/centrodedescargas/inicio
# (use a personal e-mail, AEMET has been observed to block corporate accounts)
AEMET_API_KEY=your-aemet-api-key-here

# Base URL of the AEMET OpenData REST API. Rarely needs to change.
AEMET_BASE_URL=https://opendata.aemet.es/opendata

# SQLite database file used as the local cache (relative to backend/ or absolute)
DATABASE_URL=sqlite:///./aemet_cache.db

# How long a cached range is considered fresh before we re-check AEMET, in minutes.
# AEMET only publishes new Antarctic readings a few times a day, so a short TTL
# is enough to stay "almost real-time" without hammering the source API.
CACHE_TTL_MINUTES=30

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Comma-separated list of origins allowed to call this API from a browser (the frontend)
CORS_ORIGINS=http://localhost:5173
